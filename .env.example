# Configuracoes do Motor AIHawk
# Copie este arquivo para .env e ajuste conforme seu ambiente

# Plataforma alvo para resolucao em SELECTOR_PROFILES (ex: linkedin | linkedin_clone | orangehrm)
PLATFORM=linkedin

# URLs de busca (para o clone Next.js local, use: http://localhost:3000)
STATIC_URLS=https://www.linkedin.com/jobs/search/?f_AL=true&keywords=python
CLONE_URL=http://localhost:3000

# Limite maximo de candidaturas por sessao e freio de erros consecutivos
MAX_APPLICATIONS=10
MAX_CONSECUTIVE_ERRORS=3

# Modo de execucao do navegador (false = janela visivel com interface grafica)
HEADLESS=false

# Canal do navegador: 'chromium' (recomendado, nativo Patchright) ou 'chrome' (se instalado)
BROWSER_CHANNEL=chromium

# Diretorio raiz para armazenamento das sessoes persistentes (./sessions/{platform})
SESSION_ROOT_DIR=./sessions

# Timeout padrao em milissegundos para navegacao e seletores
DEFAULT_TIMEOUT_MS=30000
